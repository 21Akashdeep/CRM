
<div id="modalItemSubGroup" class="modal fade modal-draggable" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">ItemSubGroup / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle" inert>
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formItemSubGroup">
                    <div class="row">                        
                        <div class="col-md-12">
                            <label>Name<span class="text-mandatory">*</span></label>
                            <input type="hidden" id="ItemSubGroup_Id" name="Id" />
                            <input type="text" id="ItemSubGroup_Name" name="Name" autocomplete="off" class="form-control form-control-sm item-sub-group-required" maxlength="100" />
                        </div>
                        <div class="col-md-12">
                            <label>Description<span class="text-mandatory">*</span></label>
                            <input type="text" id="ItemSubGroup_Description" name="Description" autocomplete="off" class="form-control form-control-sm item-sub-group-required" maxlength="200" />
                        </div>
                        <div class="col-md-12">
                            <label>Item Group</label>
                            <select id="ItemSubGroup_ItemGroupId" name="ItemGroupId" class="form-control form-control-sm select-pick item-sub-group-required" title="Nothing Selected" data-size="4" data-search="true" data-action="true" data-addFn="ItemGroup.fill" data-editFn="ItemGroup.edit">
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="ItemSubGroup_btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>
