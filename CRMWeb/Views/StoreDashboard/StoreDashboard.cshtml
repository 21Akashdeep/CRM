<div id="modalItemHistory" class="modal fade">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen">
        <div class="modal-content">

            <div class="modal-header">

                <div class="item-header">

                    <div class="item-title" id="historyItemName"></div>

                    <div class="item-meta">
                        <span class="dot">•</span>
                        <span id="historyItemGroup"></span>
                        <span class="dot">•</span>
                        <span id="historyItemSubGroup"></span>
                    </div>

                </div>

                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>

                    <button type="button" class="btn btn-danger rounded-5" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>

            </div>

            <div class="modal-body">
                <div class="card shadow-sm">
                <table id="tableItemHistory"
                       class="table table-bordered table-hover"
                       border="1"
                       data-unique-id="VoucherId">

                    <thead>
                        <tr>
                            <th data-formatter="tableItemHistorySLNo">#</th>
                            <th data-sortable="true" data-field="Date" data-formatter="tableItemHistoryDate">Date</th>
                            <th data-sortable="true" data-field="Type">Type</th>
                            <th data-sortable="true" data-field="No">Voucher</th>
                            <th data-sortable="true" data-field="StoreDesc">Store</th>
                            <th data-sortable="true" data-field="Party">Party</th>
                            <th data-sortable="true" data-field="Unit">Unit</th>
                            <th data-sortable="true" data-field="SerialNo" data-formatter="tableItemHistorySerial" data-escape="false">Serial No</th>
                            <th data-sortable="true" data-field="QtyIn" class="text-success">IN</th>
                            <th data-sortable="true" data-field="QtyOut" class="text-danger">OUT</th>
                            <th data-sortable="true" data-field="Balance">Balance</th>
                            <th data-sortable="true" data-field="CreatedBy">Created By</th>
                            <th data-sortable="true" data-field="CreatedAt" data-formatter="tableItemHistoryCreatedAt">Created At</th>
                        </tr>
                    </thead>

                </table>

            </div>
        </div>
    </div>
</div>
</div>







