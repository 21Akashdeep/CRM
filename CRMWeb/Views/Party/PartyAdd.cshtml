<div id="modalParty" class="modal fade modal-draggable" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">Party / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formParty">
                    <input type="hidden" id="Id" name="Id" />
                    <div class="row">
                        <div class="col-md-4">
                            <label>Name<span class="text-mandatory">*</span></label>
                            <input type="text" id="Party_Name" name="Name" autocomplete="off" class="form-control form-control-sm Party-required" maxlength="50" />
                        </div>
                        <div class="col-md-4">
                            <label>Description<span class="text-mandatory">*</span></label>
                            <input type="text" id="Party_Description" name="Description" autocomplete="off" class="form-control form-control-sm Party-required" maxlength="100" />
                        </div>
                        <div class="col-md-4">
                            <label>Party Type<span class="text-mandatory">*</span></label>
                            <select id="Party_AccountGroup" name="AccountGroupId" class="select-pick Party-required" title="Nothing Selected" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Cin No.</label>
                            <input type="text" id="Party_CinNo" name="CinNo" autocomplete="off" class="form-control form-control-sm" maxlength="21" data-alpha-lg-num="true" />
                        </div>
                        <div class="col-md-4">
                            <label>Gst No.</label>
                            <input type="text" id="Party_GstNo" name="GstNo" autocomplete="off" class="form-control form-control-sm" maxlength="15" data-alpha-lg-num="true" />
                        </div>
                        <div class="col-md-4">
                            <label>Pan No.</label>
                            <input type="text" id="Party_PanNo" name="PanNo" autocomplete="off" class="form-control form-control-sm" maxlength="10" data-alpha-lg-num="true" />
                        </div>
                        <div class="col-md-4">
                            <label>Address1<span class="text-mandatory">*</span></label>
                            <input type="text" id="Party_Address1" name="Address1" autocomplete="off" class="form-control form-control-sm Party-required" maxlength="100" />
                        </div>
                        <div class="col-md-4">
                            <label>Address2</label>
                            <input type="text" id="Party_Address2" name="Address2" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        <div class="col-md-4">
                            <label>Pin Code<span class="text-mandatory">*</span></label>
                            <input type="text" id="Party_PinCode" name="PinCode" autocomplete="off" class="form-control form-control-sm Party-required" data-num="true" maxlength="6" )" />
                        </div>
                        <div class="col-md-4">
                            <label>Post Office<span class="text-mandatory">*</span></label>
                            <input type="text" id="Party_PostOffice" name="PostOffice" autocomplete="off" class="form-control form-control-sm es-input Party-required" maxlength="100" />
                        </div>
                        <div class="col-md-4">
                            <label>District<span class="text-mandatory">*</span></label>
                            <input type="text" id="Party_District" name="District" autocomplete="off" class="form-control form-control-sm Party-required" maxlength="100" />
                        </div>
                        <div class="col-md-4">
                            <label>State<span class="text-mandatory">*</span></label>
                            <select id="Party_AdminDivId" name="AdminDivId" class="select-pick Party-required" title="Nothing Selected" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Country<span class="text-mandatory">*</span></label>
                            <select id="Party_CountryId" name="CountryId" class="select-pick Party-required" title="Nothing Selected" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Location<span class="text-mandatory">*</span></label>
                            <select id="Party_LocationId" name="LocationId" class="select-pick Party-required" title="Nothing Selected" data-search="true" data-size="4" data-addFn="Location.fill" data-editFn="Location.edit">
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Contact No.<span class="text-mandatory">*</span></label>
                            <input type="text" id="Party_ContactNo" name="ContactNo" autocomplete="off" class="form-control form-control-sm Party-required" maxlength="10" data-num="true" />
                        </div>
                        <div class="col-md-4">
                            <label>Email</label>
                            <input type="text" id="Party_Email" name="Email" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="Party_btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>

