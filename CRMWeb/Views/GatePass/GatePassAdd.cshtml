@{
}
<div id="modalGatePass" class="modal fade" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable modal-lg" role="document">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <span class="modal-title">GatePass / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>

            <!-- Body -->
            <div class="modal-body" style="min-height:75vh;">
                <form id="formGatePass">
                    <div class="row g-2">

                        <input type="hidden" id="GatePass_Id" name="Id" />

                       @* Employe  *@
                        <div class="col-md-3">
                            <label>Employee <span class="text-mandatory">*</span></label>
                            <select id="GatePass_Employee" name="EmployeeId"
                                    class="form-control form-control-sm select-pick GatePass-required"
                                    data-search="true" data-size="4">
                            </select>
                        </div>

                        @* PassType *@
                        <div class="col-md-3">
                            <label>Pass Type</label>
                            <select id="GatePass_PassType" name="Type"
                                    class="form-control form-control-sm select-pick">
                            </select>
                        </div>

                        @* GatePassNo *@
                        <div class="col-md-3">
                            <label>Pass No</label>
                            <input type="text" id="GatePass_GatePassNo" name="GatePassNo"
                                   class="form-control form-control-sm"
                                   maxlength="12" />
                        </div>

                        <!-- Identify Mark -->
                        <div class="col-md-3">
                            <label>Identify Mark <span class="text-mandatory">*</span></label>
                            <input type="text" id="GatePass_IdentifyMark" name="IdentifyMark"
                                   class="form-control form-control-sm GatePass-required"
                                   maxlength="100" autocomplete="off" />
                        </div>

                        <div class="col-md-3">
                            <label>Work Order No</label>
                            <input type="text" id="GatePass_WorkOrderNo" name="WorkOrderNo"
                                   class="form-control form-control-sm"
                                   maxlength="12" />
                        </div>

                        <div class="col-md-3">
                            <label>Company<span class="text-mandatory">*</span></label>
                            <select id="GatePass_Company" name="CompanyId"
                                    class="form-control form-control-sm select-pick GatePass-required"
                                    data-search="true" data-size="4">
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label>Location<span class="text-mandatory">*</span></label>
                            <input type="text" id="GatePass_Location" name="Location"
                                   class="form-control form-control-sm GatePass-required"
                                   maxlength="100" autocomplete="off" />
                        </div>

                        <div class="col-md-3">
                            <label>Department<span class="text-mandatory">*</span></label>
                            <input type="text" id="GatePass_Department" name="Department"
                                   class="form-control form-control-sm GatePass-required"
                                   maxlength="100" autocomplete="off" />
                        </div>

                        <div class="col-md-3">
                            <label>Safety Pass No</label>
                            <input type="text" id="GatePass_SafetyPassNo" name="SafetyPassNo"
                                   class="form-control form-control-sm"
                                   maxlength="12" />
                        </div>

                        <div class="col-md-3">
                            <label>Issued On <span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                            <input type="text" id="GatePass_IssuedOn" name="IssuedOn" class="form-control form-control-sm GatePass-required" data-date-format="DD-MMM-YYYY"/>
                            <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                        </div>
                    </div>

                        @* ExpiryOn *@
                        <div class="col-md-3">
                            <label>Expiry On <span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                            <input type="text" id="GatePass_ExpiryOn" name="ExpiryOn" class="form-control form-control-sm GatePass-required " data-date-format="DD-MMM-YYYY"/>
                            <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>


                        <div class="col-md-3">
                            <label>Training Expiry On <span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                            <input type="text" id="GatePass_TrainingExpiryOn" name="TrainingExpiryOn" class="form-control form-control-sm GatePass-required" data-date-format="DD-MMM-YYYY"/>
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Medical Expiry On <span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                            <input type="text" id="GatePass_MedicalExpiryOn" name="MedicalExpiryOn" class="form-control form-control-sm GatePass-required" data-date-format="DD-MMM-YYYY"/>
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                                </div>
                        </div>

                        <div class="col-md-3">
                            <label>Labour License Expiry On <span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                            <input type="text" id="GatePass_LabourLicenseExpiryOn" name="LabourLicenseExpiryOn"class="form-control form-control-sm GatePass-required" data-date-format="DD-MMM-YYYY"/>
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                                    </div>
                        </div>

                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" id="GatePass_btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>

        </div>
    </div>
</div>


