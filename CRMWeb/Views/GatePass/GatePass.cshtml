@{
    ViewData["Title"] = "GatePass";
}

<div class="card shadow">
    <div class="card-header">
        <span class="card-title">GatePass / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnNewEntry">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <form autocomplete="off" onsubmit="return false;">
            <div class="row">
                <div class="col-md-2">
                    <label>Status</label>
                    <select id="ListStatus" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-2">
                    <label>Location</label>
                    <select id="ListLocation" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple >
                    </select>
                </div>
                <div class="col-md-2">
                    <label>Department</label>
                    <select id="ListDepartment" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-2">
                    <label>Pass Type</label>
                    <select id="ListPassType" name ="Type" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-1">
                    <div class="btn-group">
                        <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                            <span class="fa fa-search"></span>
                        </button>
                        <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                            <span class="fa fa-print"></span>
                        </button>
                        <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                            <span class="fa fa-file-excel"></span>
                        </button>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-12">
                    <table id="tableGatePass" class="table table-bordered table-hover table-default" data-search="true" border="1" data-sort-name="Id" data-unique-id="Id">
                        <thead>
                            <tr>
                                <th data-sortable="false"data-formatter="tableGatePassSLNo" class="text-center">#</th>
                                <th data-sortable="true" data-field="EmployeeDesc">Name</th>
                                <th data-sortable="true" data-field="TypeDesc">Pass Type</th>
                                <th data-sortable="true" data-field="GatePassNo">Pass No </th>
                                <th data-sortable="true" data-field="IssuedOn" data-formatter="tableGatePassIssueOn">Issue On</th>
                                <th data-sortable="true" data-field="ExpiryOn" data-formatter="tableGatePassExpiryOn">Expiry On</th>
                                <th data-sortable="true" data-field="TrainingExpiryOn" data-formatter="tableGatePassTrainingExpiryOn">Training Expiry On</th>
                                <th data-sortable="true" data-field="MedicalExpiryOn" data-formatter="tableGatePassMedicalExpiryOn">Medical Expiry On</th>
                                <th data-sortable="true" data-field="LabourLicenseExpiryOn" data-formatter="tableGatePassLabourLicenseExpiryOn">Labour License Expiry On</th>
                                <th data-sortable="true" data-field="CreatedAt" data-formatter="tableGatePassCreatedByAndAt" class="text-nowrap">Created By & At</th>
                                <th data-sortable="true" data-field="UpdatedAt" data-formatter="tableGatePassUpdatedByAndAt" class="text-nowrap">Updated By & At</th>
                                <th data-formatter="tableGatePassStatus" class="text-nowrap text-center right-fix-2">Status</th>
                                <th data-formatter="tableGatePassAction"  data-events="tableGatePassActionEvent" class="not-print text-center right-fix">
                                    <i class="fa-solid fa-list-check"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- GatePass Add Modal -->
<partial name="GatePassAdd.cshtml" />
<!-- Hidden iframe used ONLY for printing -->
<iframe id="printFrame"
        name="printFrame"
        style="width:0;height:0;border:0;position:absolute;left:-9999px;">
</iframe>


@section Scripts {

    <script src="~/script/GatePass.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            GatePass.init();
        });
    </script>
}


