@{
    ViewData["Title"] = "User";
}
<style>
    .table label{        
        display:inline-flex;
        font-weight:bold;
    }
</style>
<div class="card shadow">
    <div class="card-header">
        <span class="card-title">User / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnAdd">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-2">
                <label>Status</label>
                <select id="ListStatus" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <label>User Type</label>
                <select id="ListUserType" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <label>User Id</label>
                <select id="ListId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <div class="btn-group">
                    <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                        <span class="fa fa-search"></span>
                    </button>
                    <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                        <span class="fa fa-print"></span>
                    </button>
                    <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                        <span class="fa fa-file-excel"></span>
                    </button>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <table id="tableUser" class="table table-bordered table-hover table-default" border="1" data-sort-name="Id" data-unique-id="Id">
                    <thead>
                        <tr>
                            <th data-sortable="true" data-field="UserId">User Id</th>                            
                            <th data-sortable="true" data-field="UserTypeDesc">User Type</th>
                            <th data-sortable="true" data-field="Name">Name</th>
                            <th data-sortable="true" data-field="Code">Code</th>
                            <th data-sortable="true" data-formatter="tableUserDateOfBirth">Date Of Birth</th>
                            <th data-sortable="true" data-field="Gender">Gender</th>
                            <th data-sortable="true" data-field="FatherName">Father's Name</th>
                            <th data-sortable="true" data-field="DepartmentDesc">Department</th>
                            <th data-sortable="true" data-field="DesignationDesc">Designation</th>
                            <th data-sortable="true" data-field="ContactNo" class="text-nowrap">Contact No.</th>
                            <th data-sortable="true" data-formatter="tableUserEmail">Email</th>                 
                            <th data-sortable="true" data-formatter="tableUserPasswordExpiredAt" class="text-nowrap">Expired At</th>
                            <th data-sortable="true" data-field="Theme" class="text-nowrap">Theme</th>
                            <th data-sortable="true" data-formatter="tableUserCreatedByAndAt" class="text-nowrap">Created By & At</th>
                            <th data-sortable="true" data-formatter="tableUserUpdatedByAndAt" class="text-nowrap">Updated By & At</th>
                            <th data-formatter="tableUserStatus" class="Status text-center right-fix-2">Status</th>
                            <th data-formatter="tableUserAction" data-events="tableUserActionEvent" class="not-print text-center right-fix"><i class="fa-solid fa-list-check"></i></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div id="modalUser" class="modal fade" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">User / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal" aria-label="Close">
                        <span class="fa fa-remove"></span>
                    </button>                    
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formUser">
                    <input type="hidden" id="Id" name="Id" />
                    <div class="row">
                        <div class="col-md-2">
                            <label>User Id<span class="text-mandatory">*</span></label>                            
                            <input type="text" id="UserId" name="UserId" autocomplete="off" class="form-control form-control-sm required" maxlength="50" />
                        </div>
                        <div class="col-md-2">
                            <label>User Type<span class="text-mandatory">*</span></label>
                            <select id="UserType" name="UserType" class="select-pick required" data-search='true'>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Name<span class="text-mandatory">*</span></label>
                            <input type="text" id="Name" name="Name" autocomplete="off" class="form-control form-control-sm required" maxlength="100" />
                        </div>                        
                        <div class="col-md-2">
                            <label>Code</label>
                            <input type="text" id="Code" name="Code" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        <div class="col-md-2">
                            <label>Date of Birth</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="DateOfBirth" name="DateOfBirth" autocomplete="off" class="form-control form-control-sm" maxlength="100" readonly/>
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                            
                        </div>
                        <div class="col-md-2">
                            <label>Gender</label>
                            <select id="Gender" name="Gender" class="select-pick" data-search="true">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Transgender">Transgender</option>
                            </select>                            
                        </div>
                        <div class="col-md-2">
                            <label>Father's Name</label>
                            <input type="text" id="FatherName" name="FatherName" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        <div class="col-md-2">
                            <label>Contact No.<span class="text-mandatory">*</span></label>
                            <input type="text" id="ContactNo" name="ContactNo" autocomplete="off" class="form-control form-control-sm required" data-num="true" data-decimal-place="0" data-min="0" data-max="9999999999" maxlength="10" />
                        </div>
                        <div class="col-md-2">
                            <label>Department<span class="text-mandatory">*</span></label>
                            <select id="DepartmentId" name="DepartmentId" class="select-pick required" data-search="true">
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label>Designation<span class="text-mandatory">*</span></label>
                            <select id="DesignationId" name="DesignationId" class="select-pick required" data-search="true">
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label>Email<span class="text-mandatory">*</span></label>
                            <input type="text" id="Email" name="Email" autocomplete="off" class="form-control form-control-sm required" maxlength="100" />
                        </div>
                    </div>                                        
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <table id="tableApi" class="table table-bordered table-hover table-default" data-table-height="250px" data-search="false" data-checkbox-header="false" data-unique-id="ApiId">
                                <thead>
                                    <tr>
                                        <th colspan="12">API</th>
                                    </tr>
                                    <tr>
                                        <th data-formatter="tableApiIsAllColChecked" data-events="tableApiIsAllColCheckedEvent" class="text-center"></th>
                                        <th data-field="ApiGroupDesc">API Group</th>
                                        <th data-field="ApiDesc">API Name</th>
                                        <th data-field="ApiTypeDesc">API Type</th>
                                        <th data-formatter="tableApiView" data-events="tableApiViewEvent" class="text-center">View</th>
                                        <th data-formatter="tableApiAdd" data-events="tableApiAddEvent" class="text-center">Add</th>
                                        <th data-formatter="tableApiUpdate" data-events="tableApiUpdateEvent" class="text-center">Update</th>
                                        <th data-formatter="tableApiDelete" data-events="tableApiDeleteEvent" class="text-center">Delete</th>
                                        <th data-formatter="tableApiEnable" data-events="tableApiEnableEvent" class="text-center">Enable</th>
                                        <th data-formatter="tableApiPrint" data-events="tableApiPrintEvent" class="text-center">Print</th>
                                        <th data-formatter="tableApiImport" data-events="tableApiImportEvent" class="text-center">Import</th>
                                        <th data-formatter="tableApiExport" data-events="tableApiExportEvent" class="text-center">Export</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>                        
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6 mt-3">
                            <table id="tableLocation" class="table table-bordered table-hover table-default" data-search="false" data-checkbox-header="false" data-unique-id="LocationId">
                                <thead>
                                    <tr>
                                        <th colspan="2">Location</th>
                                    </tr>
                                    <tr>
                                        <th data-formatter="tableLocationCheck" data-events="tableLocationCheckEvent" class="text-center"></th>
                                        <th data-field="LocationDesc">Location</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="col-md-6 mt-3">
                            <table id="tableApprovalRole" class="table table-bordered table-hover table-default" data-search="false" data-checkbox-header="false" data-unique-id="ApprovalRoleId">
                                <thead>
                                    <tr>
                                        <th colspan="2">Approval Role</th>
                                    </tr>
                                    <tr>
                                        <th data-formatter="tableApprovalRoleCheck" data-events="tableApprovalRoleCheckEvent" class="text-center"></th>
                                        <th data-field="ApprovalRoleDesc">Approval Role</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
        <script src="~/script/User.js" asp-append-version="true"></script>
        <script type="text/javascript">
            $(function () {
                User.init();
            });
        </script>
}

