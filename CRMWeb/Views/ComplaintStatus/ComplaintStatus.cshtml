@{
    ViewData["Title"] = "Complaint Status";
}

<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Complaint Status / View</span>        
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-2">
                <label>Date Range</label>
                <div class="input-group input-group-sm">
                    <input id="DateRange" type="text" class="form-control ps-1 pe-0" readonly="" style="font-size:13px; height:31px;">
                    <span class="input-group-text date-range-picker ps-1 pe-1"><i class="fa fa-calendar"></i></span>
                </div>
            </div>
            <div class="col-md-2">
                <label>Status</label>
                <select id="ListStatus" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <label>Complaint No.</label>
                <div class="input-group input-group-sm">
                    <select id="ListComplaintId" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>                    
                    </select>
                    <button type="button" id="btnSearch" class="input-group-text btn btn-sm btn-outline-success pt-1 pb-2" title="Search">
                        <span class="fa fa-search"></span>
                    </button>                    
                </div>
            </div>            
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">                
                <table id="tableComplaintSchedule" class="table table-bordered table-hover table-default" border="1" data-sort-name="Id" data-unique-id="Id">
                    <thead>
                        <tr>
                            <th data-sortable="false" data-formatter="tableComplaintScheduleSlNo" class="text-center">#</th>
                            <th data-sortable="true" data-formatter="tableComplaintScheduleComplaintInfo">Complaint Info</th>
                            <th data-formatter="tableComplaintScheduleStatus" class="text-nowrap text-center">Status</th>
                            <th data-formatter="tableComplaintScheduleAction" data-events="tableComplaintScheduleActionEvent" class="not-print text-center">
                                <i class="fa-solid fa-list-check"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div id="modalComplaintStatus" class="modal fade modal-draggable" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title"></span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formStatus">
                    <div class="row">
                        <div class="col-md-6">
                            <label>Complaint No.</label>
                            <input type="hidden" name="ComplaintId" />
                            <input id="ComplaintNo" name="ComplaintNo" class="form-control form-control-sm required" readonly/>                            
                        </div>
                        <div class="col-md-6">
                            <label>Status</label>
                            <select id="Status" name="Status" class="select-pick required" data-search="true" data-size="4"></select>
                        </div>
                        <div class="col-md-12">
                            <label>Remarks</label>
                            <input type="text" id="Remarks" name="Remarks" class="form-control form-control-sm required" />
                        </div>                        
                    </div>
                    <hr />                    
                    <div class="row">
                        <div class="col-md-12">
                            <table id="tableComplaintStatus" class="table table-border table-default">
                                <thead>                                    
                                    <tr>
                                        <th data-field="ComplaintNo"></th>
                                        <th data-field="Remarks">Remarks</th>
                                        <th data-field="Status">Status</th>
                                        <th data-field="tableComplaintStatusLogByAndAt">Log By & At</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/script/ComplaintStatus.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            ComplaintStatus.init();
        });
    </script>
}


