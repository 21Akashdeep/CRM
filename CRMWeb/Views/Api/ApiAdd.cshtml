<div id="modalApi" class="modal fade modal-draggable" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">API / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle" inert>
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formApi">
                    <div class="row">
                        <div class="col-md-12">
                            <label>Group<span class="text-mandatory">*</span></label>
                            <input type="hidden" id="Api_Id" name="Id" />
                            <select id="Api_ApiGroupId" name="ApiGroupId" class="form-control select-pick api-required" data-search="true" data-action="true" data-addFn="ApiGroup.fill" data-editFn="ApiGroup.edit" data-deleteFn="ApiGroup.delete">
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label>Name<span class="text-mandatory">*</span></label>
                            <input type="text" id="Api_Name" name="Name" autocomplete="off" class="form-control form-control-sm api-required" maxlength="100" />
                        </div>
                        <div class="col-md-12">
                            <label>Description<span class="text-mandatory">*</span></label>
                            <input type="text" id="Api_Description" name="Description" autocomplete="off" class="form-control form-control-sm api-required" maxlength="100" />
                        </div>
                        <div class="col-md-12">
                            <label>API Type<span class="text-mandatory">*</span></label>
                            <select id="Api_ApiType" name="ApiType" class="form-control form-control-sm select-pick api-required" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label>Icon</label>
                            <select id="Api_Icon" name="Icon" class="form-control form-control-sm select-pick" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label>Is Approval Required</label>
                            <select id="Api_IsApprovalRequired" name="IsApprovalRequired" class="form-control form-control-sm select-pick api-required" data-search="true" data-size="4">
                                <option value="false">No</option>
                                <option value="true">Yes</option>
                            </select>
                        </div>                        
                        <div class="col-md-12">
                            <label>Serial No.</label>
                            <input type="text" id="Api_SeqNo" name="SeqNo" autocomplete="off" class="form-control form-control-sm" data-num="true" data-decimal-place="0" />
                        </div>                        
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="Api_btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Group Add Modal -->
<partial name="../ApiGroup/ApiGroupAdd.cshtml" />


