@{
    ViewData["Title"] = "Customer";
}
<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Customer / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" data-action="Add" id="btnAdd">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <label>Status</label>
                <select id="ListStatus" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-4">
                <label>Customer</label>
                <select id="ListId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>

            <div class="col-md-4">
                <div class="btn-group">
                    <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" data-action="View" title="Search">
                        <span class="fa fa-search"></span>
                    </button>
                    <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" data-action="Print" title="Print">
                        <span class="fa fa-print"></span>
                    </button>
                    <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" data-action="Export" title="Export To Excel">
                        <span class="fa fa-file-excel"></span>
                    </button>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <table id="tableCustomer" class="table table-bordered table-hover table-default" border="1" data-sort-name="Code" data-unique-id="Id">
                    <thead>
                        <tr>
                            <th data-sortable="false" data-formatter="tableCustomerSLNo" class="text-center">#</th>
                            <th data-sortable="true" data-field="Code">Code</th>
                            <th data-sortable="true" data-formatter="tableCustomerName" class="text-nowrap">Name</th>
                            <th data-sortable="true" data-formatter="tableCustomerDescription" class="text-nowrap">Description</th>
                            <th data-sortable="true" data-field="CinNo">CinNo</th>
                            <th data-sortable="true" data-field="GstNo">GstNo</th>
                            <th data-sortable="true" data-field="PanNo">PanNo</th>
                            <th data-sortable="true" data-formatter="tableCustomerAddress" class="text-nowrap">Address</th>
                            <th data-sortable="true" data-field="ContactNo">ContactNo</th>
                            <th data-sortable="true" data-field="Email">Email</th>
                            <th data-sortable="false" data-formatter="tableCustomerCreatedByAndAt" class="text-nowrap">Created By & At</th>
                            <th data-sortable="false" data-formatter="tableCustomerUpdatedByAndAt" class="ext-nowrap">Updated By & At</th>
                            <th data-sortable="false" data-formatter="tableCustomerStatus" class="Status text-center right-fix-2">Status</th>
                            <th data-formatter="tableCustomerAction" data-events="tableCustomerActionEvent" class="not-print text-center right-fix">
                                <i class="fa fa-list-check"></i>
                            </th> 
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Api Add Modal -->
<partial name="CustomerAdd.cshtml" />
@section Scripts {

    <script src="~/script/Customer.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(()=> {
            Customer.init();
        });
    </script>
}

