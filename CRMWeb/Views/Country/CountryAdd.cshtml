<div id="modalCountry" class="modal fade modal-draggable" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">Country / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formCountry">
                    <input type="hidden"id="Id" name="Id"/>
                    <div class="row">
                        <div class="col-md-12">
                            <label>Code<span class="text-mandatory">*</span></label>
                            <input type="text" id="Country_Code" name="Code" autocomplete="off" class="form-control form-control-sm country-required" data-alpha-lg-num="true" maxlength="17" />
                        </div>
                        <div class="col-md-12">
                            <label>Name<span class="text-mandatory">*</span></label>
                            <input type="text" id="Country_Name" name="Name" autocomplete="off" class="form-control form-control-sm country-required" maxlength="50" />
                        </div>
                        <div class="col-md-12">
                            <label>Description<span class="text-mandatory">*</span></label>
                            <input type="text" id="Country_Description" name="Description" autocomplete="off" class="form-control form-control-sm country-required" maxlength="100" />
                        </div>
                        <div class="col-md-12">
                            <label>Administration Division Type<span class="text-mandatory">*</span></label>
                            <select id="Country_AdminDivType" name="AdmindivType" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label>Postal Type<span class="text-mandatory">*</span></label>
                            <select id="Country_PostalType" name="PostalType" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4">
                            </select>
                        </div>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="Country_btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>
