@{
    ViewData["Title"] = "Item";
}
<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Item / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnAdd">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-2">
                <label>Status</label>
                <select id="ListStatus" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>            
            <div class="col-md-2">
                <label>Item Group</label>
                <select id="ListItemGroupId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <label>Item Sub Group</label>
                <select id="ListItemSubGroupId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>            
            <div class="col-md-4">
                <label>Item</label>
                <select id="ListId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <div class="btn-group">
                    <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                        <span class="fa fa-search"></span>
                    </button>
                    <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                        <span class="fa fa-print"></span>
                    </button>
                    <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                        <span class="fa fa-file-excel"></span>
                    </button>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <table id="tableItem" class="table table-bordered table-hover table-default" border="1" data-sort-name="Code" data-unique-id="Id" data-row-style="tableItemRowStyle">
                    <thead>
                        <tr>
                            <th data-sortable="false" data-formatter="tableItemSlNo" class="text-center">#</th>
                            <th data-sortable="true" data-field="Code">Code</th>
                            <th data-sortable="true" data-formatter="tableItemName" class="text-nowrap">Name</th>
                            <th data-sortable="true" data-formatter="tableItemDescription" class="text-nowrap">Description</th>
                            <th data-sortable="true" data-field="ItemGroupDesc">Group</th>
                            <th data-sortable="true" data-field="ItemSubGroupDesc">Sub Group</th>
                            <th data-sortable="true" data-field="UnitDesc">Unit</th>
                            <th data-sortable="true" data-field="HsnCode">Hsn Code</th>                                                                                    
                            <th data-sortable="true" data-formatter="tableItemCreatedBy" class="text-nowrap">Created By & At</th>
                            <th data-sortable="true" data-formatter="tableItemUpdatedBy" class="text-nowrap">Updated By & At</th>
                            <th data-sortable="true" data-formatter="tableItemStatus" class="Status text-center">Status</th>
                            <th data-formatter="tableItemAction" data-events="tableItemActionEvent" class="not-print text-center">
                                <i class="fa fa-list-check"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<partial name="ItemAdd.cshtml" />
@section Scripts {
    <script src="~/script/ItemGroup.js" asp-append-version="true"></script>
    <script src="~/script/ItemSubGroup.js" asp-append-version="true"></script>
    <script src="~/script/Item.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(() => {
            Item.init();
        });
    </script>
}