@{
    ViewData["Title"] = "API Group";
}
<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Api Group / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnAdd" data-action="Add">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-2">
                <label>Status</label>
                <select id="ListStatus" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <label>Description</label>
                <select id="ListId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <label>Parent</label>
                <select id="ListParentId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <div class="btn-group">
                    <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                        <span class="fa fa-search"></span>
                    </button>
                    <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                        <span class="fa fa-print"></span>
                    </button>
                    <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                        <span class="fa fa-file-excel"></span>
                    </button>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <table id="tableApiGroup" class="table table-bordered table-hover table-default" border="1" data-sort-name="Code" data-unique-id="Id">
                    <thead>                        
                        <tr>
                            <th data-sortable="false" data-formatter="tableApiGroupSlNoFormatter" class="text-center">#</th>
                            <th data-sortable="true" data-field="Code">Code</th>
                            <th data-sortable="true" data-field="Name">Name</th>
                            <th data-sortable="true" data-field="Description">Description</th>
                            <th data-sortable="true" data-formatter="tableApiGroupIsReservedFormatter">Is Res.</th>
                            <th data-sortable="true" data-field="ParentDesc">Parent</th>
                            <th data-sortable="true" data-field="SeqNo">SL No.</th>
                            <th data-sortable="true" data-field="Icon">Icon</th>                            
                            <th data-sortable="false" data-formatter="tableApiGroupCreatedByAndAtFormatter" class="text-nowrap">Created By & At</th>
                            <th data-sortable="false" data-formatter="tableApiGroupUpdatedByAndAtFormatter" class="text-nowrap">Updated By & At</th>
                            <th data-sortable="false" data-formatter="tableApiGroupStatusFormatter" class="Status text-center">Status</th>
                            <th data-formatter="tableApiGroupActionFormatter" data-events="tableApiGroupActionEvent" class="not-print text-center">
                                <i class="fa-solid fa-list-check"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<partial name="ApiGroupAdd.cshtml" />
@section Scripts {    
    <script src="~/script/ApiGroup.js" asp-append-version="true"></script>
    <script type="text/javascript">        
        $(() => {
            ApiGroup.init();
        });
    </script>
}