<div id="modalApiGroup" class="modal fade modal-draggable" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">Api Group / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle" inert>
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formApiGroup">
                    <div class="row">
                        <div class="col-md-12">
                            <label>Name<span class="text-mandatory">*</span></label>
                            <input type="hidden" id="ApiGroup_Id" name="Id" />
                            <input type="text" id="ApiGroup_Name" name="Name" autocomplete="off" class="form-control form-control-sm api-group-required" maxlength="50" />
                        </div>
                        <div class="col-md-12">
                            <label>Description<span class="text-mandatory">*</span></label>
                            <input type="text" id="ApiGroup_Description" name="Description" autocomplete="off" class="form-control form-control-sm api-group-required" maxlength="100" />
                        </div>
                        <div class="col-md-12">
                            <label>Is Reserved<span class="text-mandatory">*</span></label>
                            <select id="ApiGroup_IsReserved" name="IsReserved" class="form-control form-control-sm select-pick api-group-required" data-search="true" data-size="4">
                                <option value="false" selected>No</option>
                                <option value="true">Yes</option>
                            </select>
                        </div>
                        <div class="col-md-12" data-groupType="Api">
                            <label>Parent</label>
                            <select id="ApiGroup_ParentId" name="ParentId" class="form-control form-control-sm select-pick" title="Nothing Selected" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-12" data-groupType="Api">
                            <label>Icon</label>
                            <select id="ApiGroup_Icon" name="Icon" class="form-control form-control-sm select-pick" title="Nothing Selected" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-12" data-groupType="Api">
                            <label>Serial No.</label>
                            <input type="text" id="ApiGroup_SeqNo" name="SeqNo" autocomplete="off" class="form-control form-control-sm" data-num="true" data-decimal-place="0" />
                        </div>                        
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="ApiGroup_btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>