<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title> - @ViewData["Title"]</title>
    <link rel="icon" href="@Url.Content("~/image/favicon.png")" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-table/bootstrap-table.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/daterange/daterangepicker.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.css" />
    <link rel="stylesheet" href="~/lib/toast/css/jquery.toast.css" />
    <link rel="stylesheet" href="~/lib/jquery-editable-select/jquery-editable-select.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/site/selectpick.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/site/site.css" asp-append-version="true" />
</head>
<body>
    <div id="appPage" class="container-fluid p-0 hide">
        <div class="progress" style="height: 5px;">
            <div id="ProgressBar" class="progress-bar bg-danger progress-bar-striped" role="progressbar" style="width: 25%;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div class="page-body" data-theme="dark">
            <div class="sidebar">
                <div class="sidebar-head">
                    <nav class="navbar navbar-expand-lg p-1">
                        <span class="app-name"></span>
                    </nav>
                </div>
                <div class="sidebar-user">
                    <table class="mb-0 border-0">
                        <tr>
                            <td class="ps-1 pe-1 text-nowrap" style="min-width:48px;">
                                <img src="~/image/user.jpg" class="rounded-circle user-image" width="40" height="40" />
                            </td>
                            <td class="ps-1 text-nowrap overflow-hidden">
                                <div class="user-name"></div>
                                <div class="user-deparment"></div>
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="sidebar-body">
                    <ul class="menu">
                    </ul>
                </div>
            </div>
            <div class="content">
                <div class="content-head">
                    <nav class="navbar navbar-expand-lg ps-2 pt-1 pb-1">
                        <span class="sidebar-toggle"><i class="fa fa-bars"></i></span>                        
                        <div class="ms-auto btn-toolbar">
                            <div class="btn-group me-1">
                                @* <button type="button" id="btnThemeFullScreen" class="btn btn-sm btn-light" onclick="Layout.fullScreen()">
                                    <span class="fa fa-expand"></span>
                                </button> *@
                            </div>
                            <div class="btn-group">
                                <div class="dropdown dropstart">
                                    <div class="user-setting user-name-first-char" id="mainDropdown" data-bs-toggle="dropdown" aria-expanded="false">S</div>
                                    <ul class="dropdown-menu mt-4" aria-labelledby="mainDropdown">
                                        <li><a class="dropdown-item" href="#" id="btnEditProfile">Theme</a></li>
                                        <li><a class="dropdown-item" href="#" id="btnEditPassword">Change Password</a></li>
                                        <li><a class="dropdown-item" href="~/">Logout</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
                <div class="content-body p-1">
                    <main role="main">
                        @RenderBody()
                    </main>
                    <div id="modalEditProfile" class="modal fade" data-bs-backdrop="static" tabindex="-1" role="dialog">
                        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <span class="modal-title">Profile / Update</span>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-danger rounded-5" data-bs-dismiss="modal">
                                            <span class="fa fa-remove"></span>
                                        </button>
                                    </div>
                                </div>
                                <div class="modal-body pt-1 pb-1" style="min-height:200px;">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label>Theme</label>
                                            <select id="Layout_Theme" name="Theme" class="select-pick profile-required" data-search="true">
                                                <option value="light">Light</option>
                                                <option value="purplin">Purplin</option>
                                                <option value="dark">Dark</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-sm btn-success rounded-5" id="btnUpdateProfile" title="Save">
                                        <span class="fa fa-save"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="modalEditPassword" class="modal fade" data-bs-backdrop="static" tabindex="-1" role="dialog">
                        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <span class="modal-title">Change Password</span>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-danger rounded-5" data-bs-dismiss="modal">
                                            <span class="fa fa-remove"></span>
                                        </button>
                                    </div>
                                </div>
                                <div class="modal-body pt-1 pb-1">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <label>Current Password</label>
                                            <div class="input-group  input-group-sm">
                                                <input type="password" class="form-control update-password-required" id="Password" />
                                                <span class="input-group-text view-password bg-transparent" style="cursor:pointer;">
                                                    <i class="fa fa-eye"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <label>Password</label>
                                            <div class="input-group input-group-sm">
                                                <input type="password" class="form-control update-password-required" id="NewPassword" />
                                                <span class="input-group-text view-password bg-transparent" style="cursor:pointer;">
                                                    <i class="fa fa-eye"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <label>Confirm Password</label>
                                            <div class="input-group  input-group-sm">
                                                <input type="password" class="form-control update-password-required" id="ConfirmPassword" />
                                                <span class="input-group-text view-password bg-transparent" style="cursor:pointer;">
                                                    <i class="fa fa-eye"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-sm btn-success rounded-5" id="btnUpdatePassword" title="Save">
                                        <span class="fa fa-save"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div id="modalRequestProcess" class="modal" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 bg-transparent">
                <div class="modal-body text-center">
                    <div class="spinner-grow text-primary" role="status" style="opacity: 1; width: 1.5rem; height: 1.5rem;">
                    </div>
                    <div class="spinner-grow text-warning" role="status" style="opacity: 1; width: 1.5rem; height: 1.5rem;">
                    </div>
                    <div class="spinner-grow text-dark" role="status" style="opacity: 1; width: 1.5rem; height: 1.5rem;">
                    </div>
                    <div class="spinner-grow text-success" role="status" style="opacity: 1; width: 1.5rem; height: 1.5rem;">
                    </div>
                    <div class="spinner-grow text-danger" role="status" style="opacity: 1; width: 1.5rem; height: 1.5rem;">
                    </div>
                    <h4 style="opacity: 1; color: #000000; font-weight: 400;">Please Wait...</h4>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="~/lib/jquery/jquery.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap/js/bootstrap.bundle.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap-table/bootstrap-table.js"></script>
    <script type="text/javascript" src="~/lib/daterange/moment.min.js"></script>
    <script type="text/javascript" src="~/lib/daterange/daterangepicker.min.js"></script>
    <script type="text/javascript" src="~/lib/jquery-ui/jquery-ui.js"></script>
    <script type="text/javascript" src="~/lib/sweetalert2/js/sweetalert2.all.js"></script>
    <script type="text/javascript" src="~/lib/toast/js/jquery.toast.js"></script>
    <script type="text/javascript" src="~/lib/jquery-editable-select/jquery-editable-select.js"></script>
    <script type="text/javascript" src="~/lib/site/selectpick.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/script/Util.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/script/Layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
