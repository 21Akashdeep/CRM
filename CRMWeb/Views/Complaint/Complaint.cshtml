@{
    ViewData["Title"] = "Complaint";
}

<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Complaint / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnAdd">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-2">
                <label>Date Range</label>
                <div class="input-group input-group-sm">
                    <input id="DateRange" type="text" class="form-control ps-1 pe-0" readonly="" style="font-size:13px; height:31px;">
                    <span class="input-group-text date-range-picker ps-1 pe-1"><i class="fa fa-calendar"></i></span>
                </div>
            </div>            
            <div class="col-md-2">
                <label>Status</label>
                <select id="ListStatus" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-3">
                <label>Customer</label>
                <select id="ListCustomerId" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-2">
                <label>Complaint No.</label>
                <select id="ListId" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                </select>
            </div>
            <div class="col-md-1">
                <div class="btn-group">
                    <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                        <span class="fa fa-search"></span>
                    </button>
                    <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                        <span class="fa fa-print"></span>
                    </button>
                    <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                        <span class="fa fa-file-excel"></span>
                    </button>
                </div>
            </div>            
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <table id="tableComplaint" class="table table-bordered table-hover table-default" border="1" data-sort-name="Id" data-unique-id="Id">
                    <thead>
                        <tr>
                            <th data-sortable="false" data-formatter="tableComplaintSlNo" class="text-center">#</th>
                            <th data-sortable="true" data-field="Date" data-formatter="tableComplaintDate" class="text-nowrap">Date</th>
                            <th data-sortable="true" data-field="Code" class="left-fix">Complaint No.</th>
                            <th data-sortable="true" data-field="SupportModeDesc">Support Mode</th>                            
                            <th data-sortable="true" data-field="CustomerDesc" data-formatter="tableComplaintCustomerDesc" class="text-nowrap">Customer & Address</th>
                            <th data-sortable="true" data-field="Problem" data-formatter="tableComplaintCustomerProblem" class="text-nowrap">Problem</th>                            
                            <th data-sortable="true" data-field="DepartmentDesc">Department</th>
                            <th data-sortable="true" data-field="AssignToName">Assign To</th>
                            <th data-sortable="true" data-field="CreatedAt" data-formatter="tableComplaintCreatedByAndAt" class="text-nowrap">Created By & At</th>
                            <th data-sortable="true" data-field="UpdatedAt" data-formatter="tableComplaintUpdatedByAndAt" class="text-nowrap">Updated By & At</th>
                            <th data-formatter="tableComplaintStatus" class="text-nowrap text-center right-fix-2">Status</th>
                            <th data-formatter="tableComplaintAction" data-events="tableComplaintActionEvent" class="not-print text-center right-fix">
                                <i class="fa-solid fa-list-check"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Complaint Add Modal -->
<partial name="ComplaintAdd.cshtml" />


@section Scripts {
    <script src="~/script/Complaint.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            Complaint.init();
        });
    </script>
}


