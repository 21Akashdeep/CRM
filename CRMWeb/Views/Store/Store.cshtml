@{
    ViewData["Title"] = "Store";
}

<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Store / View</span>
        <button type="button"
                class="btn btn-sm btn-primary float-end rounded-5"
                data-action="Add" id="btnAdd">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <label>Status</label>
                <select id="ListStatus"
                        class="form-control form-control-sm select-pick"
                        title="Nothing Selected"
                        data-size="4"
                        data-search="true"
                        data-action="true"
                        multiple>
                </select>
            </div>

            <div class="col-md-4">
                <label>Store</label>
                <select id="ListId"
                        class="form-control form-control-sm select-pick"
                        title="Nothing Selected"
                        data-size="4"
                        data-search="true"
                        data-action="true"
                        multiple>
                </select>
            </div>

            <div class="col-md-4">
                <div class="btn-group">
                    <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" data-action="View" title="Search">
                        <span class="fa fa-search"></span>
                    </button>
                    <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" data-action="Print" title="Print">
                        <span class="fa fa-print"></span>
                    </button>
                    <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" data-action="Export" title="Export To Excel">
                        <span class="fa fa-file-excel"></span>
                    </button>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <table id="tableStore"
                       class="table table-bordered table-hover table-default"
                       border="1"
                       data-sort-name="Code"
                       data-unique-id="Id">
                    <thead>
                        <tr>
                            <th data-sortable="false" data-formatter="tableStoreSLNo" class="text-center">#</th>
                            <th data-sortable="true" data-field="Code">Code</th>
                            <th data-sortable="true" data-field="Name">Name</th>
                            <th data-sortable="true" data-field="Description">Description</th>
                            <th data-sortable="false" data-formatter="tableStoreCreatedByAndAt" class="text-nowrap">Created By & At</th>
                            <th data-sortable="false" data-formatter="tableStoreUpdatedByAndAt" class="text-nowrap">Updated By & At</th>

                            <th data-sortable="false"
                                data-formatter="tableStoreStatus"
                                class="Status text-center">
                                Status
                            </th>

                            <th data-formatter="tableStoreAction"
                                data-events="tableStoreActionEvent"
                                class="not-print text-center">
                                <i class="fa fa-list-check"></i>
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="StoreAdd.cshtml" />

@section Scripts {
    <script src="~/script/Store.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(() => {
            Store.init();
        });
    </script>
}
