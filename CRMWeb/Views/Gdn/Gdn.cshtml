@{
    ViewData["Title"] = "Gdn";
}
<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Gdn / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnNewEntry">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <form autocomplete="off" onsubmit="return false;">
            <div class="row">
                <div class="col-md-2">
                    <label>Status</label>
                    <select id="ListStatus" class="form-control form-control-sm select-pick"
                            title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Customer</label>
                    <select id="ListCustomerId" class="select-pick" title="Nothing Selected"
                            data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Consignee Name</label>
                    <select id="ListConName" class="select-pick" title="Nothing Selected"
                            data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>

                <div class="col-md-2">
                    <div class="btn-group">
                        <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                            <span class="fa fa-search"></span>
                        </button>
                        <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                            <span class="fa fa-print"></span>
                        </button>
                        <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                            <span class="fa fa-file-excel"></span>
                        </button>
                    </div>
                </div>
            </div>

            <hr />

            <div class="row">
                <div class="col-md-12">
                    <table id="tableGdn" class="table table-bordered table-hover table-default" border="1"
                           data-sort-name="Code" data-unique-id="Id">
                        <thead>
                            <tr>
                                <th data-sortable="false" data-formatter="tableGdnSlNo" class="text-center">#</th>
                                <th data-sortable="true" data-field="No">Number</th>
                                <th data-sortable="true" data-field="PartyDesc">Party</th>
                                <th data-sortable="true" data-field="ConName">Consignee Name</th>
                                <th data-sortable="true" data-formatter="tableGdnConAddress" class="text-nowrap">Consignee Address</th>
                                <th data-sortable="true" data-formatter="tableGdnDate">Date</th>
                                <th data-sortable="true" data-formatter="tableGdnRefNoAndDate" class="text-nowrap">Ref No / Date</th>
                                <th data-sortable="true" data-field="Remarks">Remarks</th>
                                <th data-sortable="false" data-formatter="tableGdnCreatedByAndAt" class="text-nowrap">Created By & At</th>
                                <th data-sortable="false" data-formatter="tableGdnUpdatedByAndAt" class="text-nowrap">Updated By & At</th>
                                <th data-sortable="false" data-formatter="tableGdnStatus" class="Status text-center">Status</th>
                                <th data-formatter="tableGdnAction" data-events="tableGdnActionEvent"
                                    class="not-print text-center">
                                    <i class="fa-solid fa-list-check"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/script/Gdn.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(() => {
            Gdn.init();
        });
    </script>
}
