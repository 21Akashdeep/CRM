@{
    ViewData["Title"] = "Gdn";
}
<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Gdn / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnNewEntry">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <form autocomplete="off" onsubmit="return false;">
            <div class="row">
                <div class="col-md-2">
                    <label>Status</label>
                    <select id="ListStatus" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Date Range</label>
                    <div class="input-group input-group-sm">
                        <input id="DateRange" type="text" class="form-control" readonly>
                        <span class="input-group-text date-range-picker"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
                <div class="col-md-2">
                    <label>GDN No.</label>
                    <select id="ListNo" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Party</label>
                    <select id="ListPartyId" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="btn-group">
                        <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                            <span class="fa fa-search"></span>
                        </button>
                        <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                            <span class="fa fa-print"></span>
                        </button>
                        <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                            <span class="fa fa-file-excel"></span>
                        </button>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-12">
                    <table id="tableGdn" class="table table-bordered table-hover table-default" border="1" data-sort-name="Code"
                           data-unique-id="Id">
                        <thead>
                            <tr>
                                <th data-sortable="false" data-formatter="tableGdnSlNo" class="text-center">#</th>
                                <th data-sortable="true" data-formatter="tableGdnDate">Date</th>
                                <th data-sortable="true" data-field="No">Number</th>
                                <th data-sortable="true" data-field="StoreDesc">From Store</th>
                                <th data-sortable="false" data-formatter="tableGdnPoNoAndDate">Po No.<br />& Date</th>
                                <th data-sortable="true" data-field="PartyDesc">Party Name</th>
                                <th data-sortable="true" data-field="Remarks">Remarks</th>
                                <th data-sortable="true" data-formatter="tableGdnCreatedByAndAt" class="text-nowrap">Created By & At</th>
                                <th data-sortable="true" data-formatter="tableGdnUpdatedByAndAt" class="text-nowrap">Updated By & At</th>
                                <th data-sortable="false" data-formatter="tableGdnStatus" class="Status text-center">Status</th>
                                <th data-formatter="tableGdnAction" data-events="tableGdnActionEvent" class="not-print text-center">
                                    <i class="fa-solid fa-list-check"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>

<div id="modalGdn" class="modal fade" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title"></span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal" aria-label="Close">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formGdn" autocomplete="off" onsubmit="return false;">
                    <input type="hidden" id="Id" name="Id" />
                    <div class="row">
                        <div class="col-md-2">
                            <label>Date</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Gdn-Date" name="Date" class="form-control form-control-sm required" readonly />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label>From Store<span class="text-mandatory">*</span></label>
                            <select id="Gdn-StoreId" name="StoreId" class="select-pick required" data-search="true" data-size="4"></select>
                        </div>
                        <div class="col-md-2">
                            <label>Stock Type<span class="text-mandatory">*</span></label> 
                            <select id="Gdn-StockType" name="StockType" class="select-pick required" data-search="true" data-size="4" multiple>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Party<span class="text-mandatory">*</span></label>
                            <select id="Gdn-PartyId" name="PartyId" class="select-pick required" data-size="4" data-search="true" data-addFn="Party.newEntry" data-editFn="Party.edit"></select>
                        </div>

                        <div class="col-md-2">
                            <label>Po. No.</label>
                            <input type="text" id="Gdn-PoNo" name="PoNo" class="form-control form-control-sm " maxlength="10" data-alpha-lg-num="true" />
                        </div>
                        <div class="col-md-2">
                            <label>Po. Date</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Gdn-PoDate" name="PoDate" class="form-control form-control-sm " readonly />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label>E-Way Number</label>
                            <input type="text" id="Gdn-EwayNo" name="EwayNo" class="form-control form-control-sm " maxlength="10" data-alpha-lg-num="true" />
                        </div>
                        <div class="col-md-2">
                            <label>E-Way Date</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Gdn-EwayDate" name="EwayDate" class="form-control form-control-sm " readonly />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label>Consignee Name</label>
                            <input type="text" id="Gdn-ConName" name="ConName" class="form-control form-control-sm " maxlength="25" />
                        </div>
                        <div class="col-md-4">
                            <label>Consignee Address 1</label>
                            <input type="text" id="Gdn-ConAdd1" name="ConAdd1" class="form-control form-control-sm " maxlength="100"  />
                        </div>
                        <div class="col-md-4">
                            <label>Consignee Address 2</label>
                            <input type="text" id="Gdn-ConAdd2" name="ConAdd2" class="form-control form-control-sm" maxlength="100"  />
                        </div>
                        <div class="col-md-2">
                            <label>Consignee Pin Code</label>
                            <input type="text" id="Gdn-ConPinCode" name="ConPincode" class="form-control form-control-sm" maxlength="10" data-alpha-lg-num="true" />
                        </div>
                        <div class="col-md-2">
                            <label>Consignee Post Office</label>
                            <input type="text" id="Gdn-ConPostOffice" name="ConPostOffice" class="form-control form-control-sm" maxlength="10" data-alpha-lg-num="true" />
                        </div>
                        <div class="col-md-3">
                            <label>Consignee State</label>
                            <select id="Gdn-ConStateName" name="ConStateName" class="select-pick " data-search="true" data-size="4"></select>
                        </div>
                       
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12 gdn-item-table">
                            <table id="tableGdnItem" class="table table-bordered table-hover table-default line-item" data-search="false">
                                <thead>
                                    <tr>
                                        <th colspan="7">
                                            Gdn Item
                                            <div class="btn-group float-end">
                                                <button type="button" class="btn btn-sm btn-primary rounded-5 me-e" onclick="Gdn.addGdnItem()">
                                                    <span class="fa fa-plus"></span>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-success rounded-5" onclick=" Gdn.scanItem()">
                                                    <span class="fa fa-qrcode"></span>
                                                </button>
                                            </div>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th data-formatter="tableGdnItemSlNo" class="text-center">#</th>
                                        <th  class ="desc" data-formatter="tableGdnItemDesc" data-events="tableGdnItemDescEvent">Description</th>
                                        <th class="qty" data-formatter="tableGdnItemUnitDesc" data-events="tableGdnItemUnitDescEvent">Unit</th>
                                        <th  data-field="SerialNo">SerialNo</th>
                                        <th  data-formatter="tableGdnItemExpiryOn">ExpiryOn</th>
                                        <th class="qty" data-formatter="tableGdnItemQty" data-events="tableGdnItemQtyEvent">Qty</th>
                                        <th  data-formatter="tableGdnItemAction" data-events="tableGdnItemActionEvents"> <i class="fa fa-list-check"></i></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <label>Remarks</label>
                            <textarea type="text" id="Gdn-Remarks" name="Remarks" style="resize:none;" class="form-control form-control-sm" rows="2" maxlength="100"></textarea>
                        </div>
                    </div>
                </form>
                <div id="modalGdnItemScan" class="modal fade" data-bs-backdrop="static" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <span class="modal-title"></span>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                                        <span class="fa fa-minus"></span>
                                    </button>
                                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal" aria-label="Close">
                                        <span class="fa fa-remove"></span>
                                    </button>
                                </div>
                            </div>
                            <div class="modal-body" style="min-height:75vh;">
                                <form id="formGdnScanItem" autocomplete="off" onsubmit="return false;">
                                    <div class="row">                                       
                                        <div class="col-md-6">
                                            <label>Scan SerialNo</label>
                                            <input type="text" id="GdnScan-ItemSerialNo" name="Scan" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="row">
                                        <div class="col-md-12 Gdn-scan-item-table">
                                            <table id="tableGdnScanItem"
                                                   class="table table-bordered table-hover table-default line-item"
                                                   data-search="false">
                                                <thead>
                                                    <tr>
                                                        <th data-formatter="tableGdnItemSlNo" class="text-center">#</th>
                                                        <th data-field="ItemDesc">Item</th>                                                     
                                                        <th data-formatter="tableScanSerial">Serial No</th>
                                                        <th data-formatter="tableScanQty" class="text-end">Qty</th>
                                                        <th data-formatter="tableGdnScanItemAction" data-events="tableGdnScanItemActionEvents" class="text-center">
                                                            <i class="fa-solid fa-list-check"></i>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <hr />
                                </form>
                            </div>
                            <div class="modal-footer justify-content-end">
                                <button type="button"
                                        class="btn btn-success rounded-5" id="GdnScan-BtnAddItem">
                                    <span class="fa fa-add"></span>&nbsp;Add
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="Gdn-BtnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>

<partial name="../Party/PartyAdd.cshtml" />
<partial name="../Item/ItemAdd.cshtml" />

@section Scripts {
    <script src="~/script/ItemSubGroup.js"></script>
    <script src="~/script/ItemGroup.js"></script>
    <script src="~/script/Item.js" asp-append-version="true"></script>
    <script src="~/script/Party.js" asp-append-version="true"></script>
    <script src="~/script/Gdn.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(() => {
            Gdn.init();
        });
    </script>
}
