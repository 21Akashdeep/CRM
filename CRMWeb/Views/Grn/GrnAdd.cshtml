<div id="modalGrn" class="modal fade" data-bs-backdrop="static" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">Grn / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formGrn">
                    <input type="hidden" id="Grn_Id" name="Id" />
                    <div class="row">
                        @* Date *@
                        <div class="col-md-2">
                            <label>Date<span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Grn_Date" name="Date" autocomplete="off" class="form-control Grn-required" maxlength="50" data-date-format="DD-MMM-YYYY" />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        @* party *@
                        <div class="col-md-2">
                            <label>Party<span class="text-mandatory">*</span></label>
                            <select id="ListPartyId" name="PartyId" class="select-pick Grn-required" data-search='true' data-size="4">
                            </select>
                        </div>
                        @* CoName *@
                        <div class="col-md-2">
                            <label>Con Name<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConName" name="ConName" autocomplete="off" class="form-control form-control-sm Grn-required" maxlength="100" />
                        </div>
                        @* Con Address1 *@
                        <div class="col-md-2">
                            <label>Con Address1<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConAddress1" name="ConAddress1" autocomplete="off" class="form-control form-control-sm Grn-required" maxlength="100" />
                        </div>
                        @* Con Address2 *@
                        <div class="col-md-2">
                            <label>Con Address2</label>
                            <input type="text" id="Grn_ConAddress2" name="ConAddress2" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* ConPinCode *@
                        <div class="col-md-2">
                            <label> Con PinCode<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConPinCode" name="ConPinCode" autocomplete="off" class="form-control form-control-sm Grn-required" maxlength="6" />
                        </div>
                        @* ConPostOffice *@
                        <div class="col-md-2">
                            <label>Con PostOffice</label>
                            <input type="text" id="Grn_ConPostOffice" name="ConPostOffice" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* ConStateCode *@
                      
                        <div class="col-md-2">
                            <label>Con StateCode<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConStateCode" name="ConStateCode" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* conStateName *@
                        <div class="col-md-2">
                            <label>Con StateName<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConStateName" name="ConStateName" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* RefNo *@
                        <div class="col-md-2">
                            <label>Ref No.<span class="text-mandatory">*</span></label>
                            <select id="Grn_RefNo" name="RefNo" class="select-pick " data-search="true" data-size="4"></select>
                        </div>
                        @* RefDate *@
                        <div class="col-md-2">
                            <label>RefDate<span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Grn_RefDate" name="RefDate" autocomplete="off" class="form-control Grn-required" maxlength="50" data-date-format="DD-MMM-YYYY" />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        @* ListVoucherId *@
                        <div class="col-md-2">
                            <label>List VoucherId<span class="text-mandatory">*</span></label>
                            <select id="Grn_VoucherId" name="VoucherId" class="select-pick" data-search="true" data-size="4"></select>
                        </div>
                        @* EwayNo. *@
                        <div class="col-md-2">
                            <label>Eway No.<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_EwayNo" name="EwayNo" autocomplete="off" class="form-control form-control-sm Grn-required" data-num="true" maxlength="10" />
                        </div>
                        @* EwayDate *@
                        <div class="col-md-2">
                            <label>Eway Date<span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Grn_EwayDate" name="EwayDate" autocomplete="off" class="form-control Grn-required" maxlength="50" data-date-format="DD-MMM-YYYY" />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
        @* Remarks *@
                        <div class="col-md-12">
                            <label>Remarks<span class="text-mandatory">*</span></label>
                            <textarea type="text" id="Grn_Problem" name="Problem" class="form-control form-control-sm Grn-required" rows="4" cols="20"></textarea>
                        </div>
                    </div>
                    <hr />
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" id="btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>