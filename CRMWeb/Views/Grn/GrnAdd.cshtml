<div id="modalGrn" class="modal fade" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title"></span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal" aria-label="Close">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formGrn" autocomplete="off" onsubmit="return false;">
                    <input type="hidden" id="Id" name="Id" />
                    <div class="row">
                        @* Date *@
                        <div class="col-md-2">
                            <label>Date<span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Grn_Date" name="Date" autocomplete="off" class="form-control Grn-required" maxlength="50" data-date-format="DD-MMM-YYYY" />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        @* party *@
                        <div class="col-md-2">
                            <label>Party<span class="text-mandatory">*</span></label>
                            <select id="Gdn_CustomerId" name="CustomerId" class="select-pick Grn-required" data-search='true' data-size="4">
                            </select>
                        </div>
                        @* CoName *@
                        <div class="col-md-4">
                            <label>Consignee Name<span class="text-mandatory">*</span></label>
                            <input type="text" id="ConName" name="ConName" autocomplete="off" class="form-control form-control-sm Grn-required" maxlength="100" />
                        </div>
                        @* Con Address1 *@
                        <div class="col-md-4">
                            <label>Consignee Address1<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConAddress1" name="ConAdd1" autocomplete="off" class="form-control form-control-sm Grn-required" maxlength="100" />
                        </div>
                        @* Con Address2 *@
                        <div class="col-md-4">
                            <label>Consignee Address2</label>
                            <input type="text" id="Grn_ConAddress2" name="ConAdd2" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* ConPinCode *@
                        <div class="col-md-2">
                            <label> Consignee Pin Code<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConPinCode" name="ConPinCode" autocomplete="off" class="form-control form-control-sm Grn-required" maxlength="6" />
                        </div>
                        @* ConPostOffice *@
                        <div class="col-md-2">
                            <label>Consignee Post Office</label>
                            <input type="text" id="Grn_ConPostOffice" name="ConPostOffice" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* ConStateCode *@

                        <div class="col-md-2">
                            <label>Consignee State Code<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConStateCode" name="ConStateCode" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* conStateName *@
                        <div class="col-md-2">
                            <label>Consignee State Name<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_ConStateName" name="ConStateName" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* RefNo *@
                        <div class="col-md-2">
                            <label>Reference Number<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_RefNo" name="RefNo" autocomplete="off" class="form-control form-control-sm" maxlength="100" />
                        </div>
                        @* RefDate *@
                        <div class="col-md-2">
                            <label>Reference Date<span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Grn_RefDate" name="RefDate" autocomplete="off" class="form-control Grn-required" maxlength="50" data-date-format="DD-MMM-YYYY" />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>

                        @* EwayNo. *@
                        <div class="col-md-2">
                            <label>Eway Number<span class="text-mandatory">*</span></label>
                            <input type="text" id="Grn_EwayNo" name="EwayNo" autocomplete="off" class="form-control form-control-sm Grn-required" data-num="true" maxlength="10" />
                        </div>
                        @* EwayDate *@
                        <div class="col-md-2">
                            <label>Eway Date<span class="text-mandatory">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="Grn_EwayDate" name="EwayDate" autocomplete="off" class="form-control Grn-required" maxlength="50" data-date-format="DD-MMM-YYYY" />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        @* Remarks *@
                        @* <div class="col-md-12">
                            <label>Remarks<span class="text-mandatory">*</span></label>
                            <textarea type="text" id="Grn_Problem" name="Problem" class="form-control form-control-sm Grn-required" rows="4" cols="20"></textarea>
                        </div> *@

                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12 grn-item-table">
                            <table id="tableGrn" class="table table-bordered table-hover table-default line-item" data-search="false">
                                <thead>
                                    <tr>
                                        <th colspan="18">
                                            Grn Item
                                            <button type="button" class="btn btn-sm btn-primary float-end rounded-5 btn-add-item" onclick="Grn.addGrnItem()">
                                                <span class="fa fa-plus"></span>
                                            </button>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th data-formatter="tableGrnItemSlNo" class="text-center">#</th>
                                        <th class="desc" data-formatter="tableGrnItemDesc" data-events="tableGrnItemDescEvent">Item</th>
                                        <th class="desc" data-formatter="tableGrnItemDesc" data-events="tableGrnItemDescEvent">Store</th>
                                        <th class="desc" data-formatter="tableGrnItemDesc" data-events="tableGrnItemDescEvent">SerialNo</th>
                                        <th class="desc" data-formatter="tableGrnItemDesc" data-events="tableGrnItemDescEvent">BatchNo</th>
                                        <th class="desc" data-formatter="tableGrnItemDesc" data-events="tableGrnItemDescEvent">ExpiryOn</th>
                                        <th class="rate" data-formatter="tableGrnItemRate" data-events="tableGrnItemRateEvent">Rate</th>
                                        
                                        <th class="unit" data-field="UnitDesc">Unit</th>
                                        <th class="qty" data-formatter="tableGrnItemQty" data-events="tableGrnItemQtyEvent">Qty</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Amount</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Discount Rate</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Discount Amount</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Tax Rate</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Tax Amount</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Gross Amount</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Image</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Reason Code</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Remarks</th>
                                        @* <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">Status</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">CreatedBy</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">CreatedAt</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">UpdatedBy</th>
                                        <th class="amt" data-formatter="tableGrnItemAmount" data-events="tableGrnItemAmountEvent">UpdatedAt</th> *@
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <label>Remarks</label>
                            <textarea type="text" id="Grn-Remarks" name="Remarks" style="resize:none;" class="form-control form-control-sm" rows="2" maxlength="100"></textarea>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" id="Grn-BtnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>