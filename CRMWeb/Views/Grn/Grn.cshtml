@{
    ViewData["Title"] = "GRN";
}
@* @section Style {
    <style>

    </style>
} *@
<div class="card shadow">
    <div class="card-header">
        <span class="card-title">GRN / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnNewEntry">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <form autocomplete="off" onsubmit="return false;">
            <div class="row">
                <div class="col-md-2">
                    <label>Status</label>
                    <select id="ListStatus" class="form-control form-control-sm select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Date Range</label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="DateRange" class="form-control" readonly />
                        <span class="input-group-text date-range-picker"><i class="fa fa-calendar"></i></span>
                    </div>
                </div>
                <div class="col-md-2">
                    <label>Grn No.</label>
                    <select id="ListId" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Party</label>
                    <select id="ListCustomerId" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="btn-group">
                        <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                            <span class="fa fa-search"></span>
                        </button>
                        <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                            <span class="fa fa-print"></span>
                        </button>
                        <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                            <span class="fa fa-file-excel"></span>
                        </button>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col-md-12">
                    <table id="tableGrnItem" class="table table-bordered table-hover table-default" border="1" data-sort-name="Code"
                           data-unique-id="Id">
                        <thead>
                            <tr>
                                <th data-sortable="false" data-formatter="tableGrnSlNo" class="text-center">#</th>
                                <th data-sortable="true" data-field="GrnNo">Grn No.</th>
                                <th data-sortable="true" data-formatter="tableGrnDate">Date</th>
                                <th data-sortable="true" data-field="PartyDesc">Party</th>
                                <th data-sortable="true" data-field="ShiftDesc">Shift</th>
                                <th data-sortable="true" data-field="VehicleNo">Vehicle No.</th>
                                <th data-sortable="true" data-field="Remarks">Remarks</th>
                                <th data-sortable="false" data-formatter="tableGrnCreatedByAndAt" class="text-nowrap">Created By & At</th>
                                <th data-sortable="false" data-formatter="tableGrnUpdatedByAndAt" class="text-nowrap">Updated By & At</th>
                                <th data-sortable="false" data-formatter="tableGrnStatus" class="Status text-center">Status</th>
                                <th data-formatter="tableGrnAction" data-events="tableGrnActionEvent" class="not-print text-center">
                                    <i class="fa-solid fa-list-check"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>





<!-- Employee Add Modal -->
<partial name="GrnAdd.cshtml" />
@section Scripts {
    <script src="~/script/Grn.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(() => {
            Grn.init();
        });
    </script>
}


