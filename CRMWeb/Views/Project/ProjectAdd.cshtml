<div id="modalProject" class="modal fade modal-draggable" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title">Project / Add</span>
                <div class="btn-group">
                    <button type="button" class="btn btn-primary rounded-5 me-2" data-bs-minimize="toggle">
                        <span class="fa fa-minus"></span>
                    </button>
                    <button type="button" class="btn btn-danger rounded-5 me-2" data-bs-dismiss="modal">
                        <span class="fa fa-remove"></span>
                    </button>
                </div>
            </div>
            <div class="modal-body" style="min-height:75vh;">
                <form id="formProject">
                    <div class="row">
                        <div class="col-md-6">
                            <label> Code<span class="text-mandatory">*</span></label>
                            <input type="hidden" id="Project_Id" name="Id" />
                            <input type="text" id="Project_Code" name="Code" autocomplete="off" class="form-control form-control-sm Project-required" maxlength="50" />
                        </div>
                        <div class="col-md-6">
                            <label> Project Name<span class="text-mandatory">*</span></label>
                            @* <input type="hidden" id="Project_Id" name="Id" /> *@
                            <input type="text" id="Project_Name" name="Name" autocomplete="off" class="form-control form-control-sm Project-required" maxlength="50" />
                        </div>
                        <div class="col-md-12">
                            <label>Description<span class="text-mandatory">*</span></label>
                            <input type="text" id="Project_Description" name="Description" autocomplete="off" class="form-control form-control-sm Project-required" maxlength="100" />
                        </div>
                        <div class="col-md-12">
                            <label>Customer Id<span class="text-mandatory">*</span></label>
                            <select id="Project_CustomerId" name="CustomerId" class="form-control form-control-sm select-pick item-required" data-search="true" data-size="4">
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>PoNo<span class="text-mandatory">*</span></label>
                            <input type="text" id="PoNo" name="PoNo" autocomplete="off" class="form-control form-control-sm Project-required" maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label>Po Date</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="PoDate" name="PoDate" autocomplete="off" class="form-control form-control-sm" maxlength="100" readonly />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label>Date Start</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="StartDate" name="StartDate" autocomplete="off" class="form-control form-control-sm" maxlength="100" readonly />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label>DeadLine Date</label>
                            <div class="input-group input-group-sm">
                                <input type="text" id="DeadLineDate" name="DeadLineDate" autocomplete="off" class="form-control form-control-sm" maxlength="100" readonly />
                                <span class="input-group-text date-picker"><i class="fa fa-calendar"></i></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label>Attach Document</label>
                            <div class="file-upload">
                                <div class="file-attach">
                                    <input type="file" id="AttachTechDoc" disabled accept=".png, .jpg, .jpeg, .pdf" class="form-control form-control-sm" />
                                    <label for="AttachTechDoc" class="btn btn-sm btn-primary"><span class="fa fa-edit"></span></label>
                                </div>
                                <div class="file-preview">
                                    <iframe id="TechDocPreview" src="/image/upload.png" height="550"></iframe>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="Project_btnSave" class="btn btn-sm btn-success rounded-5">
                    <span class="fa fa-save"></span>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</div>