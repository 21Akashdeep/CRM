@{
    ViewData["Title"] = "Employee";
}

<div class="card shadow">
    <div class="card-header">
        <span class="card-title">Employee / View</span>
        <button type="button" class="btn btn-sm btn-primary float-end rounded-5" id="btnNewEntry">
            <span class="fa fa-plus"></span>&nbsp;&nbsp;Add
        </button>
    </div>
    <div class="card-body">
        <form autocomplete="off" onsubmit="return false;">
            <div class="row">
                <div class="col-md-2">
                    <label>Status</label>
                    <select id="ListStatus" class="select-pick" title="Nothing Selected" data-size="4" data-search="true" data-action="true" multiple>
                    </select>
                </div>
               
                <div class="col-md-1">
                    <div class="btn-group">
                        <button type="button" id="btnSearch" class="btn btn-sm btn-filter btn-outline-success" title="Search">
                            <span class="fa fa-search"></span>
                        </button>
                        <button type="button" id="btnPrint" class="btn btn-sm btn-filter btn-outline-secondary" title="Print">
                            <span class="fa fa-print"></span>
                        </button>
                        <button type="button" id="btnExport" class="btn btn-sm btn-filter btn-outline-primary" title="Export To Excel">
                            <span class="fa fa-file-excel"></span>
                        </button>
                    </div>
                </div>
            </div>


            <hr />


            <div class="row">
                <div class="col-md-12">
                    <table id="tableEmployee" class="table table-bordered table-hover table-default" data-search="true" border="1" data-sort-name="Id" data-unique-id="Id">
                        <thead>
                            <tr>
                                <th data-sortable="false" data-formatter="tableEmployeeSlNo" class="text-center">#</th>
                                <th data-sortable="true" data-field="Date" data-formatter="tableEmployeeDate" class="text-nowrap">Date</th>
                                <th data-sortable="true" data-field="Code" class="left-fix">Employee No.</th>
                                <th data-sortable="true" data-field="SupportModeDesc">Support Mode</th>
                                <th data-sortable="true" data-field="CustomerDesc" data-formatter="tableEmployeeCustomerDesc" class="text-nowrap">Customer & Address</th>
                                <th data-sortable="true" data-field="Problem" data-formatter="tableEmployeeProblem" class="text-nowrap">Problem</th>
                                <th data-sortable="true" data-field="CreatedAt" data-formatter="tableEmployeeCreatedByAndAt" class="text-nowrap">Created By & At</th>
                                <th data-sortable="true" data-field="UpdatedAt" data-formatter="tableEmployeeUpdatedByAndAt" class="text-nowrap">Updated By & At</th>
                                <th data-formatter="tableEmployeeStatus" class="text-nowrap text-center right-fix-2">Status</th>
                                <th data-formatter="tableEmployeeAction" data-events="tableEmployeeActionEvent" class="not-print text-center right-fix">
                                    <i class="fa-solid fa-list-check"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Employee Add Modal -->
<partial name="EmployeeAdd.cshtml" />

@section Scripts {

    <script src="~/script/Employee.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            Employee.init();
        });
    </script>
}


