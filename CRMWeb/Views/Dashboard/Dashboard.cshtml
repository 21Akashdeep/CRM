@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --card-bg: #ffffff;
        --header-blue: #2f5597;
        --text-label: #555555;
        /* --color-total: #2f5589;  */
        --color-total: #87CEFA;
        --color-soon: #f1c40f; 
        --color-expired: #e74c3c;
    }
    
    .dashboard-container {

        padding: 5px 20px;
        /* background-color: var(--bg-color); */
        font-family: 'Segoe UI', sans-serif;
        /* background-color:whitesmoke; */
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .stat-card {
        background: var(--card-bg);
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        overflow: hidden;
        border: 1px solid #e0e0e0;
        transition: transform 0.2s;
        cursor: pointer;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .overview-table {
        width: 100%;
        border-collapse: collapse;
    }

        .overview-table th {
            /* background-color: var(--header-blue); */
            /* color: #ffffff; */
            padding: 6px;
            font-size: 1.1rem;
            text-align: center;
            width: 100%;
            display: table-cell;
            box-sizing: border-box;
        }

            .overview-table th i {
                margin-right: 10px;
                font-size: 0.9em;
            }

        .overview-table td {
            padding: 2px 10px;
            border-bottom: 1px solid #f0f0f0;
            font-weight: bold;
        }

    .label-cell {
        color: var(--text-label);
        font-weight: 500;
        font-size: 1rem;
    }

    .value-cell {
        text-align: right;
        font-size: 1.4rem;
    }

    /* Color Classes */
    .blue-text {
        color: var(--color-total);
    }

    .yellow-text {
        color: var(--color-soon);
    }

    .red-text {
        color: var(--color-expired);
    }

    .dashboard-header-container {
        display: flex;
        align-items: flex-start; 
        margin-bottom: 6px;
        padding-top: 1px;
    }

    .blue-accent-bar {
        width: 6px;
        height: 30px;
        /* background-color: #2f5597;  */
        margin-right: 1px;
        border-radius: 2px;
    }

    .header-text-content {
        
        display: flex;
        flex-direction: column;
        
    }

    .main-title {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 1.5rem;
        font-weight: 800; 
        color: gray;
        line-height: 1.1;
    }

    .sub-title {
        margin: 3px 0 0 0;
        font-family: 'Segoe UI', sans-serif;
        font-size: 1rem;
        color: #666666; /* Muted gray for the description */
        font-weight: 400;
    }
   
    @@media (max-width: 992px) {
        .dashboard-grid
    {
        grid-template-columns: repeat(2, 1fr);
    }
    .main-title {
        font-size: 1.8rem;
    }
    .value-cell {
        font-size: 1.2rem;
    }
    }
    @@media (max-width: 576px) {
        .dashboard-container
    {
        padding: 12px;
    }
    .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    .dashboard-header-container {
        flex-direction: row;
        align-items: center;
    }
    .blue-accent-bar {
        height: 35px;
    }
    .main-title {
        font-size: 1.5rem;
    }
    .overview-table th {
        font-size: 1rem;
        padding: 12px;
    }

    .overview-table td {
        padding: 8px;
    }

    .label-cell {
        font-size: 0.9rem;
    }

    .value-cell {
        font-size: 1.1rem;
    }

    }
</style>

<div class="dashboard-container">

    <div class="dashboard-header-container card-header">
        @* <div class="blue-accent-bar "></div> *@
        <div class="header-text-content">
            <h1 class="main-title ">Passes Overview</h1>
            
        </div>
    </div>
    <div class="dashboard-grid table">
        <div class="stat-card" onclick="location.href='@Url.Action("Index", "GatePass")'">
            <table class="overview-table">
                <thead>
                    <tr>
                        <th colspan="2"><i class="fa-solid fa-credit-card"></i> Gate & Height</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="label-cell  blue-text">Total Passes</td><td class="value-cell blue-text" id="passTotal">0</td></tr>
                    <tr><td class="label-cell yellow-text">Expiry Soon</td><td class="value-cell yellow-text" id="passExpirySoon">0</td></tr>
                    <tr><td class="label-cell  red-text">Expired</td><td class="value-cell red-text" id="passExpired">0</td></tr>
                </tbody>
            </table>
        </div>

        <div class="stat-card" onclick="location.href='@Url.Action("Index", "GatePass")'">
            <table class="overview-table">
                <thead>
                    <tr>
                        <th colspan="2"><i class="fa-solid fa-heart-pulse"></i> Medical</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="label-cell blue-text ">Total Medical</td><td class="value-cell blue-text" id="medicalTotal">0</td></tr>
                    <tr><td class="label-cell yellow-text">Expiry Soon</td><td class="value-cell yellow-text" id="medicalExpirySoon">0</td></tr>
                    <tr><td class="label-cell red-text">Expired</td><td class="value-cell red-text" id="medicalExpired">0</td></tr>
                </tbody>
            </table>
        </div>

        <div class="stat-card" onclick="location.href='@Url.Action("Index", "GatePass")'">
            <table class="overview-table">
                <thead>
                    <tr>
                        <th colspan="2"><i class="fa-solid fa-user-graduate"></i> Training</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="label-cell  blue-text">Total Training</td><td class="value-cell blue-text" id="trainingTotal">0</td></tr>
                    <tr><td class="label-cell yellow-text">Expiry Soon</td><td class="value-cell yellow-text" id="trainingExpirySoon">0</td></tr>
                    <tr><td class="label-cell  red-text">Expired</td><td class="value-cell red-text" id="trainingExpired">0</td></tr>
                </tbody>
            </table>
        </div>

        <div class="stat-card" onclick="location.href='@Url.Action("Index", "GatePass")'">
            <table class="overview-table">
                <thead>
                    <tr>
                        <th colspan="2"><i class="fa-solid fa-address-card"></i> Labour Licence</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="label-cell  blue-text">Total Licences</td><td class="value-cell blue-text" id="labourTotal">0</td></tr>
                    <tr><td class="label-cell yellow-text">Expiry Soon</td><td class="value-cell yellow-text" id="labourExpirySoon">0</td></tr>
                    <tr><td class="label-cell  red-text">Expired</td><td class="value-cell red-text" id="labourExpired">0</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>



@section Scripts {

    <script src="~/script/Dashboard.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            Dashboard.init();
        });
    </script>
}